# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for seeding and admin tasks, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio). Free tier, keep billing disabled.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Public site URL, used for Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
