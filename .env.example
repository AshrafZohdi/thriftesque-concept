# Supabase (Project Settings > API Keys). Locally, `npm run env:local` writes these from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only: seeding and admin scripts on your machine. Never set it on the Worker.
SUPABASE_SECRET_KEY=

# Gemini (Google AI Studio). Free tier, keep billing disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Public site URL, used for Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
