# Supabase (Project Settings > API Keys). Locally, `npm run env:local` writes these from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put the Supabase secret key in any env file: OpenNext bakes every value here into the Worker bundle (D-038).
# The local seed reads it from `supabase status` itself.

# Gemini (Google AI Studio). Free tier, keep billing disabled. Fine here for local previews only;
# production gets it as a Worker secret (runbook).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Public site URL, used for Open Graph tags, robots.txt and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
