{
  "name": "thriftesque",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "cf:size": "node scripts/check-worker-size.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 8787",
    "e2e": "playwright test",
    "gate": "bash scripts/gate.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "seed": "node scripts/seed.ts",
    "demo": "node scripts/demo.ts",
    "cutouts": "node scripts/make-cutouts.ts",
    "check:build-secrets": "node scripts/check-build-secrets.mjs",
    "smoke": "bash scripts/smoke.sh",
    "deploy": "bash scripts/deploy.sh",
    "backup": "bash scripts/backup.sh",
    "env:local": "bash scripts/env-local.sh",
    "db:test": "supabase test db",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > lib/database.types.ts",
    "preview:stop": "bash scripts/stop-preview.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@opennextjs/cloudflare": "1.20.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.6",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "unrs-resolver": false,
    "fsevents": false,
    "protobufjs": false
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "type": "module"
}
